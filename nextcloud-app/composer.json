{
    "name": "requrvhive/requrvhive",
    "description": "ReQurv Hive - private AI in Nextcloud, powered by the ReQurv AI Hive OpenAI-compatible endpoint",
    "type": "project",
    "license": "AGPL-3.0-or-later",
    "require": {
        "php": "^8.4",
        "psr/log": "*",
        "symfony/http-client": "^8.0",
        "nyholm/psr7": "^1.8",
        "sabre/vobject": "^4.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0",
        "nextcloud/openapi-extractor": "^1.8",
        "nextcloud/ocp": "^35.0",
        "doctrine/dbal": "^4.4",
        "vimeo/psalm": "^6.0"
    },
    "autoload": {
        "psr-4": {
            "OCA\\RequrvHive\\": "lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OCA\\RequrvHive\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "psalm": "psalm --no-cache"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
